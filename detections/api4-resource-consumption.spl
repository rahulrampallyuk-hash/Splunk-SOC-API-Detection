# API4 - Unrestricted Resource Consumption
# Detects OTP brute force by request rate.
# Maps to OWASP API4, NIST CSF 2.0 DE.CM
#
# Validated 19 Sep 2026: detected runs of 51 and 50 OTP guesses.
# Note: crAPI returns HTTP 500 rather than 401 for an incorrect OTP.
# A 503 was observed at 51 requests per minute, indicating no rate limiting.

index=main sourcetype=access_combined uri_path="/identity/api/auth/v3/check-otp" status=500
| bin _time span=1m
| stats count AS failures BY clientip, _time
| where failures > 10
